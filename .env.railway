# Railway Production Environment Variables
NODE_ENV=production
PORT=3000

# API Configuration
API_BASE_URL=https://your-app-name.up.railway.app
API_VERSION=v1

# Railway Domain Configuration
RAILWAY_PUBLIC_DOMAIN=your-app-name.up.railway.app

# CORS Configuration - Add all allowed origins separated by commas
CORS_ORIGIN=https://your-app-name.up.railway.app,https://api.liquidsync.dev,https://app.liquidsync.dev,https://liquid-sync-api-dashboard.vercel.app

# Security
DISABLE_X_POWERED_BY=true

# Logging
LOG_LEVEL=info

# Health Check
HEALTH_CHECK_PATH=/

# Documentation
DOCS_PATH=/docs
OPENAPI_PATH=/openapi.json