{
  "name": "defi-data-api",
  "version": "1.0.0",
  "description": "DeFi Data Aggregation API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "start:debug": "nodemon --inspect=0.0.0.0:9229 src/server.ts",
    "build": "tsc && npm run postbuild",
    "postbuild": "cp -r src/static dist/ 2>/dev/null || true",
    "start": "node dist/server.js",
    "prestart": "npm run build",
    "railway:build": "tsc",
    "railway:start": "node dist/server.js",
    "docs:generate": "ts-node scripts/generate-docs.ts",
    "docs:serve": "pnpm run dev",
    "memory:update": "node .cursor/memory/update-memory.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "^3.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.15.0",
    "@scalar/express-api-reference": "^0.8.10",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.15.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.4",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.7",
    "@types/node": "^20.8.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.3",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "defi",
    "api",
    "blockchain",
    "yield",
    "bifrost"
  ],
  "author": "Your Name",
  "license": "MIT"
}
