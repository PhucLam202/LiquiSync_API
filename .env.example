NODE_ENV=development
PORT=3000
API_VERSION=v1

# External APIs
BIFROST_API_URL=

# Database
DATABASE_URL=mongodb://localhost:27017/defi-data-api

# Redis (required for email queue and OTP storage)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=your-super-secret-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
API_RATE_LIMIT=1000

# Email Configuration (Brevo)
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_NAME=DeFi Data API
BREVO_FROM_EMAIL=noreply@yourdomain.com

# Email Queue Settings (Performance Optimization)
EMAIL_QUEUE_ENABLED=true
EMAIL_WORKER_INTERVAL=2000
EMAIL_MAX_RETRY_ATTEMPTS=3
EMAIL_WORKER_CONCURRENCY=3

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Monitoring
LOG_LEVEL=info